// ACA Nursery Operations Platform - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./prod.db"
}

// String constants used as enums:
// UserRole: SUPER_ADMIN | BRANCH_MANAGER | STAFF | MAINTENANCE
// BranchStatus: ACTIVE | INACTIVE
// ClassLevel: NURSERY | KG1 | KG2
// StudentStatus: ACTIVE | WITHDRAWN
// AttendanceStatus: PRESENT | ABSENT
// MaintenanceStatus: NEW | IN_PROGRESS | COMPLETED
// Priority: LOW | MEDIUM | HIGH
// PaymentStatus: PAID | UNPAID
// ExpenseCategory: RENT | SALARIES | OPERATIONS | MAINTENANCE | OTHER

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF")
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dailyLogs           DailyLog[]
  maintenanceRequests MaintenanceRequest[]
  expenses            Expense[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  location   String
  capacity   Int
  numClasses Int
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users               User[]
  classes             Class[]
  students            Student[]
  maintenanceRequests MaintenanceRequest[]
  expenses            Expense[]
  documents           BranchDocument[]
  visitors            Visitor[]
  dailyReports        DailyReport[]
  issues              BranchIssue[]
}

// DocumentType: LICENSE | CONTRACT
// VisitType: IN_PERSON | PHONE | WHATSAPP
// FollowUpStatus: PENDING | CONTACTED | INTERESTED | RESCHEDULED | REGISTERED | NOT_INTERESTED | NO_RESPONSE
// ReferralSource: SOCIAL_MEDIA | BOOTH_CAMPAIGN | FRIEND_WORD_OF_MOUTH | PARENT_REFERRAL | BANNER_OUTDOOR | WALK_IN | WHATSAPP | GOOGLE_SEARCH | OTHER
// ProgramType: ACADEMIC_YEAR | SUMMER_CAMP
// OverallStatus: EXCELLENT | GOOD | NEEDS_ATTENTION | CRITICAL
// IssueDepartment: OPERATIONS | STUDENTS | PARENTS | STAFF | MAINTENANCE | ENROLLMENT | OTHER
// IssueType: RESIGNATION | TERMINATION | STUDENT_INCIDENT | STUDENT_ABSENCE | PARENT_COMPLAINT | PARENT_SUGGESTION | STAFF_ABSENCE | STAFF_CONDUCT | MAINTENANCE_ISSUE | REQUEST | OTHER
// IssueSeverity: LOW | MEDIUM | HIGH | URGENT
// IssueStatus: OPEN | IN_PROGRESS | RESOLVED
model BranchDocument {
  id           String   @id @default(cuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name         String
  type         String   @default("LICENSE")
  filePath     String
  originalName String
  mimeType     String
  expiryDate   DateTime
  notes        String?
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Visitor {
  id                String    @id @default(cuid())
  branchId          String
  branch            Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  visitDate         DateTime
  visitType         String    @default("IN_PERSON")
  childName         String
  guardianName      String
  guardianPhone     String?
  childDob          DateTime?
  gradeLevel        String?
  heardAboutUs      String?
  tookTour          Boolean   @default(false)
  tourAccompaniedBy String?
  guardianFeedback  String?
  notes             String?
  followUpStatus    String    @default("PENDING")
  heardAboutUsDetail String?
  targetBranch      String?
  isTransfer        Boolean   @default(false)
  transferFrom      String?
  programType       String?
  academicYear      String?
  managementRemarks String?
  handledBy         String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  followUps VisitorFollowUp[]
}

model VisitorFollowUp {
  id          String   @id @default(cuid())
  visitorId   String
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  date        DateTime
  note        String?
  result      String?
  createdById String?
  createdAt   DateTime @default(now())
}

model DailyReport {
  id                   String   @id @default(cuid())
  branchId             String
  branch               Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date                 DateTime
  managerName          String?
  childrenPresent      Int      @default(0)
  studentAbsenceIssues Int      @default(0)
  parentComplaints     Int      @default(0)
  newInquiries         Int      @default(0)
  staffAbsences        Int      @default(0)
  staffConductIssues   Int      @default(0)
  maintenanceIssues    Int      @default(0)
  newEnrollments       Int      @default(0)
  withdrawals          Int      @default(0)
  overallStatus        String   @default("GOOD")
  highlights           String?
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([branchId, date])
}

model BranchIssue {
  id             String    @id @default(cuid())
  branchId       String
  branch         Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date           DateTime
  department     String
  issueType      String
  description    String
  personInvolved String?
  severity       String    @default("MEDIUM")
  status         String    @default("OPEN")
  actionTaken    String?
  needsFollowUp  Boolean   @default(false)
  followUpDate   DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Class {
  id        String   @id @default(cuid())
  name      String
  level     String
  capacity  Int
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students  Student[]
  dailyLogs DailyLog[]

  @@unique([name, branchId])
}

model Student {
  id               String   @id @default(cuid())
  name             String
  age              Int
  branchId         String
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  classId          String
  class            Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  status           String   @default("ACTIVE")
  registrationDate DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attendances Attendance[]
  fees        Fee[]
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String
  createdAt DateTime @default(now())

  @@unique([studentId, date])
}

model DailyLog {
  id                String   @id @default(cuid())
  classId           String
  class             Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date              DateTime
  studentsPresent   Int
  operationalStatus Boolean
  note              String?
  submittedById     String
  submittedBy       User     @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())

  @@unique([classId, date])
}

model MaintenanceRequest {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type        String
  description String
  priority    String   @default("MEDIUM")
  status      String   @default("NEW")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Fee {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount        Float
  paymentStatus String    @default("UNPAID")
  paymentDate   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category    String
  amount      Float
  date        DateTime
  description String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
